# Allow system_server to read Fast Charging status
allow system_server sysfs_power_supply:file { getattr open read };
allow system_server sysfs_power_supply:file rw_file_perms;
# AxionOS: Allow system_server to read/write CPU and GPU nodes
allow system_server vendor_sysfs_devfreq:dir search;
allow system_server vendor_sysfs_devfreq:file rw_file_perms;

allow system_server sysfs_ged:dir search;
allow system_server sysfs_ged:file rw_file_perms;

allow system_server sysfs_devices_system_cpu:file rw_file_perms;
