# Audiohal
set_prop(vendor_init, vendor_mtk_audiohal_prop)
set_prop(vendor_init, vendor_mtk_audio_prop)
get_prop(vendor_init, audio_prop)

# Camera properties
set_prop(vendor_init, vendor_camera_prop)
get_prop(vendor_init, vendor_camera_prop)

# Display
set_prop(vendor_init, vendor_mtk_pq_prop)
set_prop(vendor_init, vendor_displayfeature_prop)
get_prop(vendor_init, vts_status_prop)
rw_dir_file(vendor_init, sysfs_leds)

# MediaTek
set_prop(vendor_init, vendor_mtk_manager_prop)
get_prop(vendor_init, vendor_mtk_manager_prop)

# Netflix
set_prop(vendor_init, vendor_netflix_prop)

# Powerctl
get_prop(vendor_init, powerctl_prop)

# Touch gesture
rw_dir_file(vendor_init, sysfs_tp_gesture)
rw_dir_file(vendor_init, proc_tp_gesture)
rw_dir_file(vendor_init, proc)

# Zram
allow vendor_init device:dir { search write add_name };
allow vendor_init zram_fstab_file:file create_file_perms;
type_transition vendor_init device:file zram_fstab_file "fstab.enableswap";