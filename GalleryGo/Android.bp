android_app_import {
        name: "GalleryGo",
        apk: "GalleryGo.apk",
        overrides: ["Gallery2", "SnapdragonGallery", "DotGallery", "Glimpse"],
        preprocessed: true,
        presigned: true,
        skip_preprocessed_apk_checks: true,
        dex_preopt: {
                enabled: false,
        },
        product_specific: true,
}
